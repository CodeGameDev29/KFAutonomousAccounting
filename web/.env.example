# Frontend environment for the Autonomous Accounting web app.
# Copy to web/.env only if you need to override a default.
#
# Vite requires the VITE_ prefix to expose a variable to the browser, and
# anything listed here is baked into the built bundle — never put a secret in
# this file. See https://vitejs.dev/guide/env-and-mode.html
#
# There is very little to configure. Authentication is served by the same
# origin at /api/auth/* (server/local_auth.py, web/src/lib/auth-client.ts), so
# there is no key to inline and nothing that can be half-configured.

# ---------------------------------------------------------------------------
# VITE_API_URL — base URL of the backend API.
# Default: empty, which means same-origin relative requests. That is correct
# both in development (the Vite dev server proxies /api to the local backend)
# and in production (FastAPI serves the built SPA and the API from one origin).
# Set it only when you are deliberately pointing the frontend at a backend on a
# different origin, e.g. VITE_API_URL=http://localhost:8080
# Read by: src/lib/constants.ts, src/pages/OAuthCallback.tsx
VITE_API_URL=

# ---------------------------------------------------------------------------
# VITE_API_PROXY_TARGET — where the DEV SERVER forwards /api.
# Default: http://localhost:<PORT>, with PORT read from the project-root .env
# (falling back to 8080, the same default config/settings.py uses).
# Development only; it has no effect on a production build.
# Note: this one is read by vite.config.ts from the *shell* environment, not
# from this file — export it in your shell rather than relying on .env.
# VITE_API_PROXY_TARGET=http://localhost:8080
