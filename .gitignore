# Secrets
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Node / frontend build
node_modules/
web/dist/
*.tsbuildinfo

# Runtime data and generated output.
# Every pattern here is anchored to the repository root with a leading slash:
# unanchored names match at any depth and would swallow source directories such
# as web/src/components/reports/ and core/gather/.
*.log
/logs/
/uploads/
/data/
/exports/
/renamed/
/gather/
/reports/
*.sqlite*
*.db

# Large derived reference data (see scripts/ingest_ised_benchmarks.py)
config/ised_benchmarks.json

# Per-run reconciliation audit logs hold the run's transactions. They belong in
# /logs/ (RECON_LOG_DIR); this catches one written to the checkout root anyway.
/recon_*.json

# Tooling / editors
.idea/
.vscode/

# Agent harness: the shared definition under .claude/ is tracked; what a
# session or a run produces is not. Browser-automation snapshots and skill run
# output are screenshots and dumps of whatever books the app was showing.
.claude/settings.local.json
.claude/*.lock
.claude/skills/**/runs/
.claude/skills/**/reports/
.claude/skills/**/screenshots/
.claude/skills/**/progress.json
.claude/skills/**/node_modules/
.playwright-mcp/
