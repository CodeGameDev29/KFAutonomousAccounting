# Autonomous Accounting — environment template.
#
# Copy to .env and fill in. The database, the file store, the identity service
# and the language model are all local, so most of this file is already correct
# as written and only the two generated secrets and DATABASE_URL need
# attention.
#
# `<required>` means the app will not start (or the feature will not work)
# without it. Every other line below is the value the code already defaults to,
# written out so you can see it and change it. Leaving an optional key empty
# disables the feature it belongs to rather than causing an error.
#
# This file lists every variable the code actually reads. The list was produced
# by walking the Python sources for `os.getenv` / `os.environ` reads, not from
# memory. (TEMP, USER and USERNAME are also read, but those come from the
# operating system, not from here.)
#
# Not every variable below belongs to the web application: the last two
# sections are read by the test suite and by the scripts under `scripts/`, and
# are listed so the file stays a complete answer to "what does this code read?".

# ── Deployment ──────────────────────────────────────────────────────
# DEPLOY_MODE selects the application, not the hosting:
#   "cloud" = the web app (REST + SSE + PostgreSQL). This is what you want.
#   "local" = the single-user SQLite desktop mode, which is not maintained.
DEPLOY_MODE=cloud
APP_ENV=production
# Public origin of the app, used to build OAuth callbacks and confirm links.
APP_URL=http://localhost:8080
BASE_URL=http://localhost:8080
# Where the dev frontend runs; used for one redirect after onboarding. The code
# defaults to 5173, but the Vite dev server in web/vite.config.ts is pinned to
# 5174 — set this to http://localhost:5174 if you use `npm run dev`.
FRONTEND_URL=http://localhost:5173
# Optional. A link to your own project/status page shown in generated reports.
# Empty = no link is rendered anywhere.
PUBLIC_SITE_URL=
# Port uvicorn binds. The launcher scripts read this too.
PORT=8080

# ── Database — local PostgreSQL ──────────────────────────────────────
# <required>. A PostgreSQL 15+ database you own (nothing in db/ needs a server
# feature newer than 13; 15 is just the oldest still-maintained release).
# Create it, then apply the schema in THIS ORDER (local_auth_schema.sql first:
# it creates the `auth` schema and auth.uid(), which schema_pg.sql's
# row-level-security policies call; local_grants.sql last, because it grants on
# the tables the previous steps create):
#     createdb autonomous_accounting
#     psql -d autonomous_accounting -f db/local_auth_schema.sql
#     psql -d autonomous_accounting -f db/schema_pg.sql
#     python -m db.migrate
#     psql -d autonomous_accounting -f db/local_grants.sql
# There is no managed database and no remote fallback: this is the only copy of
# your books, so back it up (scripts/local/backup-aa.ps1 does a pg_dump).
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/autonomous_accounting
# MIGRATIONS_BASELINE is deliberately NOT listed as a variable here. It is a
# one-shot switch you put in front of a single command, not a setting, and this
# file wins over the shell (it is loaded with override=True, so an empty KEY=
# really means off) — an entry here would silently cancel it.
#   MIGRATIONS_BASELINE=1  record every pending migration as applied WITHOUT
#                          running it, for a database brought up to date by hand.

# ── Auth — the local JWT issuer (server/local_auth.py) ──────────────
# <required>. Generate with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
# Rotating this invalidates every live session. It ALSO re-keys stored
# integration credentials unless CREDENTIAL_ENCRYPTION_SECRET is set — see below.
AUTH_JWT_SECRET=
AUTH_ACCESS_TOKEN_TTL_SECONDS=3600
AUTH_REFRESH_TOKEN_TTL_DAYS=30
# 1 = a new signup is usable immediately. The right default with no mail
# transport configured to deliver a confirmation link through. Set to 0 only if
# SMTP below is configured.
AUTH_AUTOCONFIRM=1
# Registration is CLOSED by default: POST /api/auth/signup returns 403 and the
# UI hides every signup entry point. Set to 1 to deliberately open it. You will
# need it open once, to create your own first account: set 1, restart, sign up,
# set it back to 0. Every signed-in account has full access to every feature.
AUTH_ALLOW_SIGNUP=0
# Optional. Set this to decouple credential encryption from session signing, so
# AUTH_JWT_SECRET can be rotated without making every stored Gmail/Wise/PayPal
# credential permanently undecryptable. Defaults to AUTH_JWT_SECRET.
CREDENTIAL_ENCRYPTION_SECRET=
# Namespaces for the credential-encryption key derivation. Change them once, at
# setup time, to values of your own; changing them later invalidates every
# stored integration credential.
AA_CREDENTIAL_NAMESPACE=aa-credentials-v1
AA_CLOUD_CREDENTIAL_NAMESPACE=CHANGE_ME_CREDENTIAL_NAMESPACE
AA_MACHINE_ID_FALLBACK=CHANGE_ME_MACHINE_ID_FALLBACK

# ── File storage — local disk, HMAC-signed download links ───────────
# Absolute path. Receipts, statements and exports live here. Empty = ./data/storage
# inside the checkout, which .gitignore already excludes.
STORAGE_ROOT=
# <required>. Keys the signature on download links; without it they are forgeable.
# Falls back to AUTH_JWT_SECRET when empty. Generate the same way.
STORAGE_URL_SECRET=
STORAGE_URL_TTL_SECONDS=3600
# Largest file any upload route will accept, in megabytes. One number for
# receipts, bank statements, note attachments and the generic file upload; it is
# also what GET /health reports as limits.max_upload_mb, which is how the web UI
# knows to reject an over-sized file before sending it. The cost of raising it
# is render memory when a very long PDF is rasterised for extraction.
MAX_UPLOAD_MB=50

# ── LLM providers (the engine) ──────────────────────────────────────
# A local, OpenAI-compatible endpoint is the PRIMARY provider: free, private,
# on hardware you already have. vLLM, llama.cpp, Ollama's /v1 endpoint and LM
# Studio all work — point LLM_BASE_URL at one and set LLM_MODEL to the name it
# serves. The model must be vision-capable: receipts and statements are read as
# images. When the endpoint does not answer, uploads return HTTP 503 saying
# exactly that; nothing silently falls back to a hosted provider.
# (LOCAL_LLM_BASE_URL / LOCAL_LLM_MODEL / LOCAL_LLM_API_KEY are still read as
# older aliases for these three.)
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=primary
# Dummy value: the openai client refuses an empty key, most local servers ignore it.
LLM_API_KEY=local
LOCAL_LLM_TIMEOUT_S=180
# How many extraction calls may be in flight at once. Servers that batch
# concurrent requests (vLLM) gain real throughput here; raise it carefully.
LOCAL_LLM_MAX_CONCURRENT=4
# Same idea for the matcher's short classification calls, which plateau later.
LOCAL_LLM_ENGINE_MAX_CONCURRENT=10
# Reasoning-style models emit <think> blocks by default; they cost seconds and
# break strict JSON parsing, so extraction turns them off where supported.
LOCAL_LLM_DISABLE_THINKING=1
# Per-call timeout for the hosted providers below (seconds).
LLM_CALL_TIMEOUT_S=45
# Ceiling on concurrent hosted-provider extractions.
LLM_MAX_CONCURRENT_EXTRACTIONS=5

# How sharply a scanned receipt page is rasterised for the vision model. The
# first pages go at RECEIPT_FIRST_PAGES_DPI and the rest at RECEIPT_BATCH_DPI.
# A batch that comes back with nothing readable (a faint scan that vanished at
# the lower setting) is re-rendered once at RECEIPT_RETRY_DPI and asked again.
RECEIPT_FIRST_PAGES_DPI=200
RECEIPT_BATCH_DPI=150
RECEIPT_RETRY_DPI=200

# Optional hosted fallbacks. Each is skipped entirely while its key is empty,
# so a configuration with no keys never sees a 401 — it just uses the local model.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Optional: comma-separated override of the fallback ladder.
GEMINI_MODEL_LADDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_FALLBACK_MODEL=gpt-4.1

# ── LLM bank-statement parser ───────────────────────────────────────
LLM_STATEMENT_DPI=150
LLM_STATEMENT_GEMINI_MODEL=gemini-2.5-flash
LLM_STATEMENT_OPENAI_MODEL=gpt-4.1
LLM_STATEMENT_THINKING_BUDGET=512
# Cents of drift allowed before a parsed statement fails its balance check.
LLM_STATEMENT_BALANCE_TOLERANCE_CENTS=2

# ── Categorization agent ────────────────────────────────────────────
CATEGORIZATION_JSON_MAX_TOKENS=4096
# Hard ceiling on model calls in one categorization run.
CATEGORIZATION_LLM_CALL_BUDGET=200

# ── Reconciliation engine ───────────────────────────────────────────
# Hard maximum number of days between a proof of transaction's date and a bank
# transaction's date. A candidate outside the window is dropped whatever the
# amount says. This is the fallback: an account that sets its own
# "max date variance" in Settings overrides it for itself.
RECONCILIATION_DATE_WINDOW_DAYS=45
# At or above this score a match is settled without asking; below
# RECONCILIATION_REVIEW_THRESHOLD it is not proposed at all.
RECONCILIATION_AUTO_APPROVE_THRESHOLD=0.90
RECONCILIATION_REVIEW_THRESHOLD=0.60
# Floor for "Approve all" on the review queue. A bulk approval accepts a batch
# sight unseen, so it only settles matches at or above this score; the rest stay
# in the queue. A request may raise this bar for itself but never lower it.
RECONCILIATION_BULK_APPROVE_MIN_CONFIDENCE=0.85
RECONCILIATION_AMOUNT_WEIGHT=0.5
RECONCILIATION_DATE_WEIGHT=0.3
RECONCILIATION_VENDOR_WEIGHT=0.2
# Pass 1's model call, off by default. The pass is a union with the
# deterministic amount shortlist, so switching the call off can only remove
# candidates the model alone proposed. Set to 1 to re-enable it.
RECONCILIATION_AMOUNT_AGENT_LLM=0
RECONCILIATION_LINKER_MAX_CONCURRENT=4
# The band a CAD/USD cross-currency match is allowed to reconcile inside.
FX_CAD_USD_MIN=1.20
FX_CAD_USD_MAX=1.55
# Dollars of bank fee a wire may differ by and still match its invoice.
WIRE_FEE_TOLERANCE=25.00
# Comma-separated patterns your OWN outgoing invoices are issued under. Used to
# tell an invoice you sent (income) from a bill you received (expense).
OWN_COMPANY_PATTERNS=your company,your company inc
# Where the per-run reconciliation audit JSON is written.
# Empty = ./logs/reconciliation inside the checkout.
RECON_LOG_DIR=

# ── Peer-benchmark (reasonableness) engine ──────────────────────────
# Static reference data, read-only, relative to the repo root.
BENCHMARK_DATA_PATH=config/ised_benchmarks.json
GIFI_MAPPING_PATH=config/aa_category_gifi_map.yaml
REASONABLENESS_REVENUE_FLOOR=30000
REASONABLENESS_PARTIAL_YEAR_MIN_DAYS=335
REASONABLENESS_MATERIALITY_FLOOR_PCT=0.02
REASONABLENESS_MATERIALITY_FLOOR_ABS=500
REASONABLENESS_MATERIALITY_REF_PCT=0.10
REASONABLENESS_MATERIALITY_FLOOR_FRAC=0.25
REASONABLENESS_ELEVATED_CUTOFF=1.0
REASONABLENESS_STANDS_OUT_CUTOFF=2.0
REASONABLENESS_DEFAULT_SPREAD_PCT=0.5
REASONABLENESS_MIN_SPREAD=0.01
REASONABLENESS_MIN_BUSINESS_COUNT=20
REASONABLENESS_WELL_BEYOND_IQR_MULT=1.0
REASONABLENESS_MEDIAN_ONLY_TOLERANCE_PCT=0.15
REASONABLENESS_PROFITABILITY_COHORT=pm_q4
REASONABLENESS_TOP_N_FLAGS=5
REASONABLENESS_SEVERAL_STANDS_OUT=2
REASONABLENESS_SEVERAL_TOTAL_FLAGS=4
REASONABLENESS_TRAVEL_ABS=0.05
REASONABLENESS_MEALS_ABS=0.05
REASONABLENESS_VEHICLE_ABS=0.05
REASONABLENESS_CONTRACTOR_SKEW_FRAC=0.60
REASONABLENESS_CONTRACTOR_SKEW_MIN_REV=0.25
REASONABLENESS_GENERIC_SHARE_FRAC=0.50
# Rate used only when a currency has no published rate for a day, so totals are
# never silently summed across currencies.
REASONABLENESS_FX_FALLBACK=1.35

# ── CORS ────────────────────────────────────────────────────────────
# Extra origins allowed to call the API. localhost origins are always allowed.
ALLOWED_ORIGINS=

# ── App config ──────────────────────────────────────────────────────
FISCAL_YEAR=2026
LOG_LEVEL=INFO
# Feature flags switched on for every account, as a JSON array, e.g. ["beta-thing"].
BETA_FLAGS_DEFAULT_ON=[]

# ── Outbound email (optional, your own SMTP server) ─────────────────
# Unset by default, and that is the correct default: with no SMTP server
# configured the app sends no mail at all. Signup auto-confirms
# (AUTH_AUTOCONFIRM=1 above), so no link has to be delivered, and with
# SMTP_HOST empty the confirmation and password-reset helpers log the link
# instead of raising. Fill these in only to use a mail server you already run.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Sign in with Google (optional) ──────────────────────────────────
# An account created through Google may have no local password at all, in which
# case this is that account's only way in. Talks to Google directly; there is no
# broker in between and it costs nothing.
#   1. Google Cloud console -> APIs & Services -> OAuth consent screen.
#      External + Testing is right: under 100 users, no verification needed.
#      Add every account that must sign in as a Test User, or Google blocks it.
#   2. Create an OAuth 2.0 Client ID of type "Web application".
#   3. Authorized redirect URI, exactly:  <APP_URL>/api/auth/google/callback
# Leave blank to hide the Google button entirely rather than show a dead one.
# The same client is reused by the Gmail document-gathering integration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Override only if Gmail's redirect differs from <BASE_URL>/api/onboarding/gmail/callback,
# which is the path core/gather/gmail.py builds when this is empty.
GMAIL_REDIRECT_URI=

# ── Optional document/transaction sources (unset = feature hidden) ──
WISE_API_TOKEN=
# 1 to talk to Wise's sandbox instead of the live API.
WISE_SANDBOX=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX=false
# Second, human-browsable copy of every gathered file.
# Empty = ./data/gather-mirror inside the checkout; set to "" to disable.
GATHER_MIRROR_DIR=

# ── Rendering ───────────────────────────────────────────────────────
# Fonts used when a typed note is rendered to an image. Names are resolved
# through the platform's font directories; an absolute .ttf path also works.
# Empty = try a list of common monospace/sans fonts, then Pillow's built-in.
NOTE_MONO_FONT=
NOTE_SANS_FONT=

# ── Single-user desktop mode (DEPLOY_MODE=local only) ───────────────
# DATA_DIR=data
# DB_PATH=autonomous_accounting.db

# ── Test suite ──────────────────────────────────────────────────────
# Read by tests/conftest.py. A DSN for the throwaway database the suite creates,
# used exactly as written; its name must end in "_test" or collection refuses to
# start. Leave it empty and the suite derives a "_test" sibling of DATABASE_URL,
# which is what makes a bare `pytest` work on a fresh checkout.
TEST_DATABASE_URL=
# Read by tests/test_statement_detector.py. A directory of your own statements,
# receipts and invoices for the volume tests, which this repository does not
# ship. Those tests skip when it holds nothing. Commented out because these are
# paths, and an empty path is a valid one — set it or leave it alone.
# AA_BULK_FIXTURES=

# ── Developer scripts ───────────────────────────────────────────────
# Read by scripts/qa/manifest.py. Where your own statements, receipts and
# workbooks live for the QA comparison scripts. Gitignored, never in the repo.
# AA_QA_DATA_DIR=data/books
# Read by scripts/qa/xlsx_parser_per_account.py when it is run directly: the
# per-account workbook it parses.
# QA_XLSX_PER_ACCOUNT=data/books/per-account-sheets.xlsx
#
# The Windows launcher scripts under scripts/local/ read these; they are not
# application settings and belong in the shell, not in .env:
#   AA_HOME, AA_PG_BIN, AA_PG_DATA, AA_LOG_DIR, AA_PYTHON,
#   AA_TUNNEL_CMD, AA_TUNNEL_ARGS, PUBLIC_HOSTNAME
